# Local development defaults
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=veterinary_app
DB_SSL=false

# Auth: set a long random value in production
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Aiven deployment values: replace the DB_* values with Aiven credentials
# and set DB_SSL=true. Put the downloaded Aiven CA certificate in DB_CA.
# DB_HOST=mysql-xxxxx.aivencloud.com
# DB_PORT=xxxxx
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_NAME=defaultdb
# DB_SSL=true
# DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
